@page "/list-projects"
@using System.Security.Claims
@using FormulaForge.Domain.Entities
@using FormulaForge.Domain.Services
@using FormulaForge.Web.Extensions
@using Microsoft.AspNetCore.Components.Authorization
@inject IProjectManagementService ProjectManagementService
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable

<PageTitle>Projects list</PageTitle>

<FluentCard>
    
    <FluentListbox Items="@ProjectsItems" 
                   TOption="Option<Project>"
                   OptionText="@(i => i.Value?.Name)" 
                   SelectedOptionChanged="@OnProjectSelected" />
    
</FluentCard>

@code {
    
    private readonly CancellationTokenSource _cts = new();

    public Project[] Projects { get; set; } = [];

    public Option<Project>[] ProjectsItems => Projects
        .Select(p => new Option<Project>
        {
            Value = p,
            Text = p.Name,
        }).ToArray();

    public Option<Project>? SelectedProject { get; set; }

    [Inject] public required NavigationManager NavigationManager { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        var userId = await AuthenticationStateProvider.GetUserIdAsync();
        if (userId == null)
            Projects = [];
        else
            Projects = await ProjectManagementService.GetProjectsAsync(userId).ToArrayAsync(_cts.Token);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private Task OnProjectSelected(Option<Project>? arg)
    {
        SelectedProject = arg;
        
        var project = arg?.Value;
        
        if (project == null) return Task.CompletedTask;
        
        NavigationManager.NavigateTo($"edit-project/{project.Id}", forceLoad: true);
        return Task.CompletedTask;
    }

}