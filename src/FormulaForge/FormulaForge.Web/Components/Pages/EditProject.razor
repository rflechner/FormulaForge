@page "/edit-project/{projectId:guid?}"

<PageTitle>Computation script</PageTitle>

<FluentAppBar PopoverShowSearch="false" Orientation="Orientation.Horizontal">
    
    <FluentAppBarItem OnClick="@RunScript"
                      Style="cursor: pointer;"
                      Match="NavLinkMatch.All"
                      IconRest="PlayIcon()"
                      IconActive="PlayIcon(active: true)"
                      Text="Run script" />
    
    <FluentAppBarItem OnClick="@SaveProject"
                      Style="cursor: pointer;"
                      Match="NavLinkMatch.All"
                      IconRest="SaveIcon()"
                      IconActive="SaveIcon(active: true)"
                      Text="Save" />
    
</FluentAppBar>

<FluentCard>
    <FluentTextField @bind-Value="Project.Name" Label="Project name"></FluentTextField>
</FluentCard>

<FluentCard>
    <h3>Inputs</h3>
    <ExcelGrid Months="@_months" Rows="@_inputsRows" />
</FluentCard>

<FluentCard>
    <StandaloneCodeEditor Id="my-editor-id" CssClass="my-editor-class" 
                          @ref="_editor"
                          ConstructionOptions="EditorConstructionOptions" />
</FluentCard>

<FluentCard>
    <h3>Outputs</h3>
    <ExcelGrid Months="@_months" Rows="@_outputsRows"/>
</FluentCard>