@page "/"
@using FormulaForge.Engine.Time

<PageTitle>Home</PageTitle>

<FluentCard>
    <h2>Hello World!</h2>
    <FluentButton Appearance="@Appearance.Accent">Click Me</FluentButton>
</FluentCard>

<FluentCard>
    <h3>Excel Grid Example</h3>
    <ExcelGrid @rendermode="InteractiveServer" Months="@_months" Rows="@_rows" />
</FluentCard>

@code {
    private List<DateTime> _months = new();
    private List<ExcelGrid.RowData> _rows = new();

    protected override void OnInitialized()
    {
        _months = Period.OfYear(2026).GetMonths().Select(m => m.InclusiveStart.DateTime).ToList();

        _rows = new List<ExcelGrid.RowData>
        {
            new ExcelGrid.RowData
            {
                Name = "Revenue",
                Values = new() { {1, 10000}, {2, 12000}, {3, 15000} }
            },
            new ExcelGrid.RowData
            {
                Name = "Costs",
                Values = new() { {1, 5000}, {2, 6000}, {3, 7000} }
            },
            new ExcelGrid.RowData
            {
                Name = "Profit",
                Values = new() { {1, 5000}, {2, 6000}, {3, 8000} }
            }
        };
    }
}
