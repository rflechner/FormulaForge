@rendermode InteractiveServer

<div class="excel-grid-container">
    <table class="excel-grid">
    <thead>
        <tr>
            <th class="sticky-col">Variable</th>
            @foreach (var month in Months)
            {
                <th>@month.ToString("MMM yyyy")</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Rows)
        {
            <tr>
                <td class="sticky-col read-only">
                    <div class="cell-content">@row.Name</div>
                </td>

                @foreach (var month in Months)
                {
                    var cellId = $"{row.Id}-{month.Ticks}";
                    var isEditing = _editingCellId == cellId;

                    <td class="@(isEditing ? "editing" : "")">
                        @if (isEditing)
                        {
                            <input @ref="_activeInput"
                                   type="number"
                                   value="@GetValue(row, month)"
                                   @oninput="(e) => UpdateValue(row, month, e.Value)"
                                   @onblur="StopEdit"
                                   @onkeydown="(e) => HandleKeyDown(e, row, month)"
                                   @onclick:stopPropagation="true"
                                   autofocus />
                        }
                        else
                        {
                            <div class="cell-content" @onclick="() => StartEdit(cellId)">
                                @FormatValue(GetValue(row, month))
                            </div>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [Parameter] public List<DateTime> Months { get; set; } = new();
    [Parameter] public List<RowData> Rows { get; set; } = new();

    private string? _editingCellId;
    private ElementReference _activeInput;

    public class RowData {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Name { get; set; }
        public Dictionary<int, decimal> Values { get; set; } = new();
    }

    private decimal GetValue(RowData row, DateTime month) => 
        row.Values.GetValueOrDefault(month.Month, 0);

    private void StartEdit(string cellId)
    {
        _editingCellId = cellId;

        StateHasChanged();
    }

    private void StopEdit() => _editingCellId = null;

    private void UpdateValue(RowData row, DateTime month, object? value)
    {
        if (decimal.TryParse(value?.ToString(), out decimal res))
        {
            row.Values[month.Month] = res;
        }
    }

    private string FormatValue(decimal val) => val == 0 ? "-" : val.ToString("N2");

    private void HandleKeyDown(KeyboardEventArgs e, RowData row, DateTime month)
    {
        if (e.Key == "Enter") StopEdit();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_editingCellId != null && _activeInput.Context != null)
        {
            await _activeInput.FocusAsync();
        }
    }
}
