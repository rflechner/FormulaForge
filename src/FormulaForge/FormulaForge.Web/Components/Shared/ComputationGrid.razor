@rendermode InteractiveServer

@if (Scalars.Any())
{
    <div class="scalars-panel">
        @foreach (var scalar in Scalars)
        {
            <div class="scalar-card">
                <div class="scalar-name">@scalar.Name</div>
                <div class="scalar-value">@FormatScalarValue(scalar.ScalarValue)</div>
            </div>
        }
    </div>
}

<div class="excel-grid-container">
    <table class="excel-grid">
    <thead>
        <tr>
            <th class="sticky-col">Variable</th>
            @foreach (var month in Months)
            {
                <th>@month.ToString("MMM yyyy")</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Series)
        {
            <tr>
                <th class="sticky-col read-only">
                    <div class="cell-content">@row.Name</div>
                </th>

                @foreach (var month in Months)
                {
                    var cellId = $"{row.Id}-{month.Ticks}";
                    var isEditing = _editingCellId == cellId;

                    <td class="@(isEditing ? "editing" : "")">
                        @if (isEditing)
                        {
                            <input @ref="_activeInput"
                                   type="number"
                                   value="@GetValue(row, month)"
                                   @oninput="(e) => UpdateValue(row, month, e.Value)"
                                   @onblur="StopEdit"
                                   @onkeydown="(e) => HandleKeyDown(e, row, month)"
                                   @onclick:stopPropagation="true"
                                   autofocus />
                        }
                        else
                        {
                            <div class="cell-content" @onclick="() => StartEdit(cellId)">
                                @FormatValue(GetValue(row, month))
                            </div>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
</div>

