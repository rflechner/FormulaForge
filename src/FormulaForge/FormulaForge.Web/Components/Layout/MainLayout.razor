@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="flex h-full">

    <!-- ===== SIDEBAR ===== -->
    <aside class="hidden md:flex w-[230px] shrink-0 flex-col border-r border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900">

        <!-- Logo -->
        <div class="flex items-center gap-2.5 px-5 h-16 border-b border-stone-200 dark:border-stone-800">
            <div class="grid h-8 w-8 place-items-center rounded-lg bg-orange-600 text-white shadow-sm shadow-orange-600/30">
                <i data-lucide="square-function" class="h-5 w-5"></i>
            </div>
            <div class="leading-tight">
                <div class="text-[15px] font-semibold tracking-tight">FormulaForge</div>
                <div class="text-[10px] uppercase tracking-widest text-stone-400">Forge de calculs</div>
            </div>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-4 space-y-0.5 text-sm">
            <a href="/" class="@NavCls("/", exact: true)">
                <i data-lucide="layout-dashboard" class="h-[18px] w-[18px]"></i> Tableau de bord
            </a>
            <a href="/list-projects" class="@NavCls("/list-projects")">
                <i data-lucide="folder-kanban" class="h-[18px] w-[18px]"></i> Projets
            </a>
            <a href="/edit-project" class="@NavCls("/edit-project")">
                <i data-lucide="square-pen" class="h-[18px] w-[18px]"></i> Éditeur
            </a>
            <a href="/connectors" class="@NavCls("/connectors")">
                <i data-lucide="plug-zap" class="h-[18px] w-[18px]"></i> Connecteurs
            </a>

            @if (IsOnEditPage)
            {
                <div class="pt-4 pb-1 px-3 text-[10px] font-semibold uppercase tracking-widest text-stone-400">Ce projet</div>
                <a href="#" class="flex items-center gap-3 rounded-lg px-3 py-2 text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800/70 transition-colors">
                    <i data-lucide="line-chart" class="h-[18px] w-[18px]"></i> Time series
                </a>
                <a href="#code" class="flex items-center gap-3 rounded-lg px-3 py-2 text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800/70 transition-colors">
                    <i data-lucide="braces" class="h-[18px] w-[18px]"></i> Script
                </a>
            }
        </nav>

        <!-- Footer -->
        <div class="px-4 py-3 border-t border-stone-200 dark:border-stone-800">
            <a href="https://github.com/rflechner/FormulaForge" target="_blank"
               class="flex items-center gap-2 text-xs text-stone-500 hover:text-stone-800 dark:hover:text-stone-200 transition-colors">
                <i data-lucide="git-branch" class="h-4 w-4"></i> Open source · v0.9.2
            </a>
        </div>
    </aside>

    <!-- ===== MAIN COLUMN ===== -->
    <div class="flex min-w-0 flex-1 flex-col">

        <!-- Top bar -->
        <header class="flex h-16 shrink-0 items-center justify-between gap-4 border-b border-stone-200 dark:border-stone-800 bg-white/80 dark:bg-stone-900/80 backdrop-blur px-5">
            <div class="flex items-center gap-2 text-sm min-w-0">
                @if (IsOnEditPage)
                {
                    <a href="/list-projects" class="text-stone-500 hover:text-stone-800 dark:hover:text-stone-200 transition-colors">Projets</a>
                    <i data-lucide="chevron-right" class="h-4 w-4 text-stone-300 dark:text-stone-600"></i>
                    <span class="font-medium truncate">Éditeur</span>
                }
                else
                {
                    <span class="font-medium">@PageLabel</span>
                }
            </div>
            <div class="flex items-center gap-1.5">
                <button onclick="ffToggleTheme()"
                        class="grid h-9 w-9 place-items-center rounded-lg text-stone-500 hover:bg-stone-100 dark:hover:bg-stone-800 hover:text-stone-800 dark:hover:text-stone-200 transition-colors ff-focus"
                        title="Basculer le thème">
                    <i data-theme-icon="1" data-lucide="moon" class="h-[18px] w-[18px]"></i>
                </button>
                <div class="mx-1 h-6 w-px bg-stone-200 dark:bg-stone-700"></div>
                <AuthorizeView>
                    <Authorized>
                        <button class="flex items-center gap-2 rounded-lg pl-1 pr-2 py-1 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors">
                            <span class="grid h-7 w-7 place-items-center rounded-full bg-stone-800 dark:bg-stone-700 text-[11px] font-semibold text-white">
                                @UserInitials(context.User.Identity?.Name)
                            </span>
                            <span class="hidden sm:block text-sm font-medium">@context.User.Identity?.Name</span>
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/list-projects"
                           class="inline-flex items-center gap-2 rounded-lg border border-stone-300 dark:border-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors">
                            Connexion
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <!-- Page content -->
        <main class="ff-scroll flex-1 overflow-y-auto">
            @Body
        </main>
    </div>
</div>

@code {
    private bool IsOnEditPage => NavigationManager.Uri.Contains("/edit-project", StringComparison.OrdinalIgnoreCase);

    private string PageLabel
    {
        get
        {
            var uri = new Uri(NavigationManager.Uri);
            var path = uri.AbsolutePath.TrimEnd('/');
            if (path.EndsWith("/list-projects", StringComparison.OrdinalIgnoreCase)) return "Projets";
            if (path.Contains("/edit-project", StringComparison.OrdinalIgnoreCase)) return "Éditeur";
            if (path.EndsWith("/connectors", StringComparison.OrdinalIgnoreCase)) return "Connecteurs";
            return "Tableau de bord";
        }
    }

    private string NavCls(string href, bool exact = false)
    {
        var uri = new Uri(NavigationManager.Uri);
        var path = uri.AbsolutePath;
        var isActive = exact
            ? path.TrimEnd('/').Equals(href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
            : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "flex items-center gap-3 rounded-lg px-3 py-2 font-medium text-orange-700 dark:text-orange-400 bg-orange-50 dark:bg-orange-500/10 ring-1 ring-inset ring-orange-600/15 dark:ring-orange-400/20"
            : "flex items-center gap-3 rounded-lg px-3 py-2 text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800/70 transition-colors";
    }

    private static string UserInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }
}
