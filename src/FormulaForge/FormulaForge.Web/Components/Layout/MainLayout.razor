@using Microsoft.FluentUI.AspNetCore.Components.Icons.Filled
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />

<FluentLayout Style="min-height: 100vh;">
    <FluentHeader>
        Formula Forge
        <FluentSpacer />
        <AuthorizeView>
            <Authorized>
                @{
                    var pictureUrl = context.User.Claims.FirstOrDefault(c => c.Type == "picture")?.Value;
                    var avatarUrl = !string.IsNullOrEmpty(pictureUrl) ? $"/avatar?url={Uri.EscapeDataString(pictureUrl)}" : null;
                }
                <FluentPersona Name="@context.User.Identity?.Name"
                               Image="@avatarUrl"
                               Status="PresenceStatus.Available"
                               Style="cursor: pointer;"
                               Id="user-persona" />
                <FluentMenu Anchor="user-persona" Trigger="MouseButton.Left">
                    <FluentMenuItem Icon="@(new Icons.Regular.Size20.Person())" OnClick="@(() => NavigationManager.NavigateTo("/me"))">My Profil</FluentMenuItem>
                    <FluentDivider />
                    <FluentMenuItem Icon="@(new Icons.Regular.Size20.SignOut())" OnClick="@(() => NavigationManager.NavigateTo("/logout", true))">
                        Logout
                    </FluentMenuItem>
                </FluentMenu>
            </Authorized>
            <NotAuthorized>
                <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => NavigationManager.NavigateTo("/list-projects", forceLoad: true))">Login</FluentButton>
            </NotAuthorized>
        </AuthorizeView>
    </FluentHeader>
    
    <FluentStack Orientation="Orientation.Horizontal" Width="100%" Style="flex: 1;">
            <FluentNavMenu Width="250">
                
                <FluentNavLink Href="/" Icon="@(new Icons.Regular.Size24.Home())" Match="NavLinkMatch.All">Home</FluentNavLink>
                
                <AuthorizeView>
                    <Authorized>
                        <FluentNavLink Href="/list-projects" Icon="@(new Icons.Regular.Size24.DocumentSearch())" Match="NavLinkMatch.All">List Projects</FluentNavLink>
                        <FluentNavLink Href="/edit-project" Icon="@(new Icons.Regular.Size24.Calculator())" Match="NavLinkMatch.All">New Project</FluentNavLink>
                    </Authorized>
                </AuthorizeView>

            </FluentNavMenu>

            <FluentBodyContent>
                @Body
            </FluentBodyContent>
        
    </FluentStack>
    
    <FluentFooter Style="height: 25px; padding-left: 10px; padding-right: 10px; padding-top: 5px; padding-bottom: 5px; background-color: transparent; border-top: 1px solid #0a53be;">
        Open source application &nbsp;<a href="https://github.com/rflechner/FormulaForge" target="_blank">Github</a>
        <FluentSpacer />
        Copyright © @(DateTime.Now.Year) FormulaForge
    </FluentFooter>
    
</FluentLayout>


<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>