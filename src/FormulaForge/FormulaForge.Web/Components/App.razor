<!DOCTYPE html>
<html lang="fr" class="h-full">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>

    <!-- Prevent flash of wrong theme -->
    <script>(function(){try{var t=localStorage.getItem('ff-theme');if(t==='dark'||(!t&&matchMedia('(prefers-color-scheme: dark)').matches)){document.documentElement.classList.add('dark');}}catch(e){}})();</script>

    <!-- Geist font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet">

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        if (window.tailwind) {
            tailwind.config = {
                darkMode: 'class',
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Geist', 'ui-sans-serif', 'system-ui', '-apple-system', 'sans-serif'],
                            mono: ['"Geist Mono"', 'ui-monospace', 'SFMono-Regular', 'monospace'],
                        },
                    },
                },
            };
        }
    </script>

    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["FormulaForge.Web.styles.css"]"/>

    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet/>
</head>

<body class="h-full bg-stone-50 dark:bg-stone-950 text-stone-900 dark:text-stone-100 font-sans antialiased">
<Routes @rendermode="InteractiveServer"/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<script src="@Assets["ff-theme.js"]"></script>
<script src="@Assets["monacoInterop.js"]"></script>
<script src="@Assets["lib/monaco-editor/vs/loader.js"]"></script>
</body>

</html>
