<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FormulaForge.ApiService.Persistence.Postgres\FormulaForge.ApiService.Persistence.Postgres.csproj" />
        <ProjectReference Include="..\FormulaForge.ApiService.Persistence\FormulaForge.ApiService.Persistence.csproj" />
        <ProjectReference Include="..\FormulaForge.Domain.Services\FormulaForge.Domain.Services.csproj" />
        <ProjectReference Include="..\FormulaForge.Domain\FormulaForge.Domain.csproj" />
        <ProjectReference Include="..\FormulaForge.Engine\FormulaForge.Engine.csproj" />
        <ProjectReference Include="..\FormulaForge.ServiceDefaults\FormulaForge.ServiceDefaults.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="appsettings.Development.json">
        <DependentUpon>appsettings.json</DependentUpon>
      </Content>
      <Content Update="package-lock.json">
        <DependentUpon>package.json</DependentUpon>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Npgsql" Version="13.1.1" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.4" />
      <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.0" />
      <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Emoji" Version="4.14.0" />
      <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.0" />
      <PackageReference Include="SkiaSharp" Version="3.119.2" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
      <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.2" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\lib\monaco-editor\vs\assets\" />
      <Folder Include="wwwroot\lib\monaco-editor\vs\editor\" />
    </ItemGroup>

    <Target Name="CopyMonaco" BeforeTargets="BeforeBuild">
        <ItemGroup>
            <MonacoFiles Include="node_modules\monaco-editor\min\vs\**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(MonacoFiles)" DestinationFolder="wwwroot\lib\monaco-editor\vs\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>
